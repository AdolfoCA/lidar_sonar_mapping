<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perf_tools</name>
  <version>0.0.1</version>
  <description>
    Zero-touch performance-measurement suite for the seabed-to-sky mapping
    stack. Captures per-stage latency, system/per-process resources and map
    growth during a rosbag replay, and produces publication-quality figures
    and a summary table for an IEEE real-time-on-Jetson evaluation.
  </description>
  <maintainer email="adocafaro@gmail.com">User</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime: capture nodes (rclpy). Analysis (pandas/matplotlib) runs
       standalone on a laptop and is intentionally not a ROS dependency. -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
